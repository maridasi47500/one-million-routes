<%= form_with(model: framework) do |form| %>
  <% if framework.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(framework.errors.count, "error") %> prohibited this framework from being saved:</h2>

      <ul>
        <% framework.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

<textarea style="height:300px;">Consider a harmuful character as bang, This does not work:

echo `cat <<EOF
  {"branch":"foo","value":"bar!"}
EOF`

This does:

echo \"`cat <<EOF
  {"branch":"foo","value":"bar!"}
EOF`\"
</textarea>
  <div>
    <%= form.label :mycode, style: "display: block" %>
<p>ecris la ligne de code pour creer le programme en insérant MYNAME à la place du nom du programme</p>
    <%= form.text_area :mycode, style:"width:100%;height:200px;" %>
  </div>

  <div>
    <%= form.label :mylogincode, style: "display: block" %>
    <%= form.text_area :mylogincode, style:"width:100%;height:200px;" %>
  </div>

  <div>
    <%= form.label :myroutecode, style: "display: block" %>
<p>ecris la ligne de code en bash pour creer une route dans le programme avec NOM_DE et _MA_ROUTE à la place du nom de la route si elle est en une/deux partie, et MON_URL à la place de l'url pour ecrire le nom de la route en camel case, MY_URL mon url de route</p>
<p>ecris DOWNCASE_NOM_DE et DOWNCASE_MA_ROUTE à la place du nom de la route si elle est en une/deux partie pour ecrire le nom de la route en minuscule </p>
    <%= form.text_area :myroutecode, style:"width:100%;height:200px;" %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
