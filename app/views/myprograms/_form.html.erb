<%= form_with(model: myprogram) do |form| %>
  <% if myprogram.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(myprogram.errors.count, "error") %> prohibited this myprogram from being saved:</h2>

      <ul>
        <% myprogram.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :framework_id, style: "display: block" %>
    <%= form.select :framework_id, Framework.all.collect{|h|[h.name, h.id]} %>
  </div>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.text_field :description %>
  </div>

  <div>
    <%= form.label :user_id, style: "display: block" %>
    <%= form.number_field :user_id %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
