<%= form_with(model: myroute) do |form| %>
  <% if myroute.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(myroute.errors.count, "error") %> prohibited this myroute from being saved:</h2>

      <ul>
        <% myroute.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :myprogram_id, style: "display: block" %>
    <%= form.select :myprogram_id, Myprogram.all.collect{|h|[h.title+" ("+h.framework.name+")", h.id]} %>
  </div>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.text_field :description %>
  </div>

  <div>
    <%= form.label :myurl, style: "display: block" %>
    <%= form.text_field :myurl %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
